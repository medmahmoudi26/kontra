# kontra — the copy-paste cluster's configuration. Every value has a working default.
#
#   gh api repos/medmahmoudi26/kontra/contents/.env.quickstart \
#     -H "Accept: application/vnd.github.raw" > .env
#
# THIS IS NOT `.env.example`. That one is a development checkout. This file configures the
# Compose cluster (ADR 0047): Postgres, Temporal, SeaweedFS, Redis, registry, orchestrator
# roles, workspace seed/watch.

# ── the one line that matters for security ───────────────────────────────────────────────────────
#
# WHERE THE PORTS ARE PUBLISHED. `127.0.0.1` means only this machine can reach the control plane.
# A published Docker port bypasses ufw. Do not change this to 0.0.0.0.
KONTRA_BIND=127.0.0.1

# ── which images ─────────────────────────────────────────────────────────────────────────────────
#
# PIN THEM the moment this is anything you depend on. `latest` moves on every `docker compose pull`.
#
# Built it yourself (`make image` + orchestrator + host images)? Point these at local tags and
# set KONTRA_PULL_POLICY=never.
KONTRA_IMAGE=ghcr.io/medmahmoudi26/kontra:latest
KONTRA_ORCHESTRATOR_IMAGE=ghcr.io/medmahmoudi26/kontra-orchestrator:latest
KONTRA_HOST_IMAGE=ghcr.io/medmahmoudi26/kontra-host:1
KONTRA_PULL_POLICY=missing

# ── where your actors and workflows live ─────────────────────────────────────────────────────────
#
# BLANK MEANS `<this directory>/workspace`, bind-mounted at the same absolute path inside every
# service that reads code. Seed copies hello actor+workflow only when that directory is empty.
KONTRA_WORKSPACE=

# A Tenant IS a Temporal namespace.
KONTRA_NAMESPACE=default

# Host-side ports. Move one when something on this machine already holds it.
KONTRA_API_PORT=8088
KONTRA_TEMPORAL_PORT=7233
KONTRA_S3_PORT=8333
KONTRA_KV_PORT=6379
KONTRA_REGISTRY_PORT=5000
KONTRA_POSTGRES_PORT=5432

# Console login is GENERATED on first boot (workspace-init), printed once:
#   docker compose logs workspace-init | grep -A4 'console login'
# Lost it? `docker compose exec cli kontra user add <name>`
KONTRA_CONSOLE_USERS=
KONTRA_STATE_TOKEN=
KONTRA_RUN_TOKEN=
KONTRA_PANEL_TOKEN=
KONTRA_EXPLORE_TOKEN=

# Pulumi encrypts dockerFleet state with this. Local-only default. `down -v` destroys that state
# AND every Dataset. Change it before you have a Fleet you care about; losing it makes stack
# secrets unreadable.
PULUMI_CONFIG_PASSPHRASE=local-dev

# Optional DigitalOcean fleet. Unused by docker_fleet().
DIGITALOCEAN_TOKEN=
KONTRA_CLOUD_CREDENTIAL=
KONTRA_PROBE_QUEUE=kontra-probe

# Pinned so `docker compose` finds the same stack whichever directory you run it from.
COMPOSE_PROJECT_NAME=kontra
