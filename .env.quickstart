# kontra — the copy-paste install's configuration. Every value here has a working default; you can
# run `docker compose up -d` with this file untouched.
#
#   curl -fsSL https://raw.githubusercontent.com/medmahmoudi26/kontra/main/.env.quickstart -o .env
#
# THIS IS NOT `.env.example`. That one configures a development checkout — a Pulumi passphrase, a
# DigitalOcean token, an SSH key, the paths of a clone — and most of its blanks are things you must
# fill in before anything works. This file configures ONE CONTAINER and nothing in it is required.

# ── the one line that matters for security ───────────────────────────────────────────────────────
#
# WHERE THE PORTS ARE PUBLISHED. `127.0.0.1` means only this machine can reach the control plane.
#
# DO NOT CHANGE THIS TO 0.0.0.0 TO "MAKE IT WORK FROM ANOTHER MACHINE". A published Docker port is
# DNATed in `PREROUTING` and accepted in `FORWARD` — it never traverses `ufw-user-input`, so ufw,
# firewalld and every other host firewall let it straight through no matter what they report.
# Measured on this project's own controller: ufw active, ten ports open to the internet anyway.
#
# Widening this exposes an unauthenticated Temporal frontend, an S3-compatible object store, a
# Redis-protocol state store and an OCI registry that accepts pushes. If you need remote access,
# terminate TLS and authentication in a reverse proxy bound to your public interface and point it at
# 127.0.0.1:8088 — or use a VPN or an SSH tunnel. Leave this line alone.
KONTRA_BIND=127.0.0.1

# ── which kontra ─────────────────────────────────────────────────────────────────────────────────
#
# THE PUBLISHED IMAGE. Nothing is compiled on your machine — no Go, no Node, no pnpm, and no
# 20-minute build that depends on how much RAM and disk you happen to have free.
#
# PIN IT the moment this is anything you depend on. `latest` moves on every `docker compose pull`,
# and a control plane that changed version during an unrelated `restart` is the hardest kind of
# surprise to debug:
#
#   KONTRA_IMAGE=ghcr.io/medmahmoudi26/kontra:0.1.0
#
# Built it yourself from a clone (`make image`)? Point this at it and set KONTRA_PULL_POLICY=never:
#
#   KONTRA_IMAGE=kontra:latest
KONTRA_IMAGE=ghcr.io/medmahmoudi26/kontra:latest

# WHETHER COMPOSE MAY FETCH THAT IMAGE. `never` while the image is a local build, because the error
# for a missing unqualified tag is a LIE: Docker expands `kontra:latest` to
# `docker.io/library/kontra:latest`, and Hub answers "does not exist or may require 'docker login'"
# — which sends you to fix credentials you do not need. It is the first thing that happens if you
# copy these files to a second machine and skip `make image`.
#
# `missing` because KONTRA_IMAGE above names a registry: pull it once, then never again unless the
# tag is gone. Set this to `never` if you point KONTRA_IMAGE at a LOCAL tag you built — an
# unqualified name like `kontra:latest` is expanded to `docker.io/library/kontra:latest`, and Hub
# answers "does not exist or may require 'docker login'", which sends you to fix credentials you do
# not need. `never` says `No such image` instead, which is the truth.
KONTRA_PULL_POLICY=missing

# ── where your actors and workflows live ─────────────────────────────────────────────────────────
#
# BLANK MEANS "THE DIRECTORY YOU RAN `docker compose up` IN", which is what you want: put your
# actor folders beside these two files and `kontra actor register ./firstactor` works with no
# further thought.
#
# WHY IT IS MOUNTED AT THE SAME PATH INSIDE. An Actor is a FOLDER, and registering one sends the
# resolved path; the orchestrator opens it to read the manifest and derive the form the console
# draws. If the two sides spell it differently, the CLI resolves `/home/you/work/firstactor` and
# the container answers `no such directory`.
#
# SET IT TO AN ABSOLUTE PATH to keep your code elsewhere — and you MUST set it on a shell that
# does not export `PWD`, which includes PowerShell.
KONTRA_WORKSPACE=

# ── the tenant ───────────────────────────────────────────────────────────────────────────────────
#
# A Tenant IS a Temporal namespace — separate history, separate retention, a real boundary rather
# than a label. `default` exists on first boot and is the right answer until you have a second
# customer's runs to keep apart from the first's.
KONTRA_NAMESPACE=default

# ── ports on the host side ───────────────────────────────────────────────────────────────────────
#
# Only the HOST half. The container always listens on the standard numbers, so changing these moves
# the port you type in a browser and changes nothing inside. Move one when something on this machine
# already holds it — 6379 on a box that already runs Redis is the usual collision.
KONTRA_API_PORT=8088
KONTRA_TEMPORAL_PORT=7233
KONTRA_S3_PORT=8333
KONTRA_KV_PORT=6379
KONTRA_CODEC_PORT=18234
KONTRA_REGISTRY_PORT=5000

# ── the console login, and why it is blank ───────────────────────────────────────────────────────
#
# BLANK HERE MEANS "GENERATED", NOT "OPEN" — the opposite of what a blank usually means in an env
# file. On first boot the container runs `kontra init`, which mints the `admin` account and the four
# service tokens, hashes the password into `config.yaml` inside the volume and PRINTS IT ONCE:
#
#   docker compose logs kontra | grep -A4 'console login'
#
# That is the only time the password exists in readable form; only a scrypt hash is kept. Lost it?
#
#   docker compose exec kontra kontra user add <name>
#
# Setting these instead is supported and is what a config-managed install does — the file is loaded
# WITHOUT overriding anything already in the environment, so a value you set here wins over the
# generated one. `KONTRA_CONSOLE_USERS` takes `name:hash` pairs, never a plaintext password.
KONTRA_CONSOLE_USERS=
KONTRA_STATE_TOKEN=
KONTRA_RUN_TOKEN=
KONTRA_PANEL_TOKEN=
KONTRA_EXPLORE_TOKEN=

# ── the project name ─────────────────────────────────────────────────────────────────────────────
#
# Pinned so `docker compose` finds the same stack whichever directory you run it from. Without it
# compose names the project after the invoking directory, and a copy of these two files in a second
# folder silently becomes a SECOND control plane racing the first for port 8088.
COMPOSE_PROJECT_NAME=kontra
