{
  "projectId": "cf64b3c8-5663-43ec-955c-31c66d5cbd49",
  "shape": "package",
  "pkg": "@kontra/frontend",
  "globalName": "KontraDashboard",
  "buildCmd": "cd frontend && ../../.ds-sync/node_modules/.bin/tailwindcss -i .ds-tailwind.css -o .ds-styles.css",
  "tsconfig": ".ds-tsconfig.json",
  "readmeHeader": ".design-sync/conventions.md",
  "cssEntry": ".ds-styles.css",
  "extraFonts": [
    "src/panels/fonts/nerd-font.css"
