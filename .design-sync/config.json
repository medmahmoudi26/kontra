    "SideRail": "src/panels/chrome/SideDock.tsx",
    "SideDockControls": "src/panels/chrome/SideDock.tsx",
    "PaneStack": "src/panels/chrome/PaneStack.tsx",

    "TileWall": "src/panels/grid/TileWall.tsx",
