{
  "mediaType": "application/json",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "date": {
        "description": "When, as an RFC 3339 date-time.",
        "format": "date-time",
        "type": "string"
      },
      "guests": {
        "description": "How many guests.",
        "maximum": 6,
        "minimum": 1,
        "type": "integer"
      },
      "name": {
        "description": "The name the table is booked under.",
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "name",
      "guests",
      "date"
    ],
    "type": "object"
  }
}
