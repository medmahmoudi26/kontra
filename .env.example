# kontra — what an installation needs, and what breaks when each is empty.
#
# COPY THIS TO `.env`.  `.env` is gitignored because it holds live credentials; this file exists so
# a fresh clone has something to copy and so there is ONE place that answers "what does this
# installation need". Before it existed, every missing variable failed separately and without naming
# itself.
#
# ── TWO KINDS OF BLANK, AND THEY ARE OPPOSITES ───────────────────────────────────────────────────
#
# Read this before leaving anything empty:
#
#   OPEN      a blank leaves a surface reachable by anyone who can reach the API.
#   DISABLED  a blank makes a surface answer 503 and do nothing.
#
# Both are marked below on every line where it matters. `kontra init` generates the tokens for a new
# installation; `kontra token mint <key>` fills a blank one in an existing config.
#
# NOTHING IN THIS FILE IS A WORKING CREDENTIAL. Every secret is blank on purpose — a default
# password in a checked-in file is the first thing an attacker tries, and it is why this repository
# does not copy the one-command installs that ship one.

# ── compose ──────────────────────────────────────────────────────────────────────────────────────

# The compose project name. Every container, network and volume is prefixed with it, so changing it
# on an existing install orphans the old ones rather than adopting them.
COMPOSE_PROJECT_NAME=kontra-local

# The checkout the control plane serves workflows FROM. Mounted into orchestrator-api, and the root
# that `serve` is allowed to run a file from — narrowing it narrows what that route can execute.
KONTRA_CHECKOUT=/root/kontra-local

# ── where things listen, and where Machines call home ────────────────────────────────────────────

# THE ADDRESS SERVICES BIND. This is the control that keeps the data plane off the internet — not
# the firewall, which cannot see a container's published port at all (Docker DNATs it in PREROUTING
# and accepts it in FORWARD, never traversing ufw's INPUT chain).
#
# 127.0.0.1 for a laptop. On a controller with fleet Machines, this is the PRIVATE VPC address they
# reach it on — never the public one.
KONTRA_BIND=127.0.0.1

# Where fleet Machines call home for Temporal, Redis, S3 and the catalog. NOT localhost: on a
# Machine that means its own loopback, and the Worker starts, registers nothing, and looks idle.
KONTRA_CONTROLLER=10.124.0.2

# ── THE CONTROL PLANE AS A CONTAINER ─────────────────────────────────────────────────────────────
#
# `docker compose up -d` runs `kontra up` inside the `kontra` service. Nothing below is needed to
# run the appliance on the HOST instead (`kontra up`), which is the other supported path — see
# README's "docker compose is not the control plane" and docs/wiki/First-Run.md.
#
# THE IMAGE IS BUILT FROM A RELEASE TARBALL, so the container is the same bytes a user downloads.
# `make image` cuts one for this platform and builds it.
KONTRA_IMAGE=kontra:latest

# WHERE YOUR `.kontra/` IS ON THE HOST, mounted into the container AT THE SAME PATH.
#
# It has to be the same path on both sides: an Actor or a workflow is a FOLDER, registering one
# records its path, and a path that means two different things across the container boundary is a
# `serve` that reads a directory which is not there. `~` is not expanded by compose — write it out.
KONTRA_HOME_HOST=/root/.kontra

# The published ports. Each is bound to KONTRA_BIND above, which is the ONLY control — see the
# warning there about Docker and ufw. Changing one of these changes the HOST side only; inside the
# container the appliance always uses its defaults.
KONTRA_API_PORT=8088
KONTRA_TEMPORAL_PORT=7233
KONTRA_S3_PORT=8333
KONTRA_KV_PORT=6379
KONTRA_CODEC_PORT=18234
KONTRA_REGISTRY_PORT=5000

# A Tenant IS a Temporal namespace. `default` exists already; a second one separates two customers'
# history and retention, which is a real boundary rather than a label.
KONTRA_NAMESPACE=default

# Reached by containers that need the appliance running on the host.
KONTRA_TEMPORAL_ADDRESS=host.docker.internal:7233
KONTRA_S3_APPLIANCE_ENDPOINT=http://host.docker.internal:8333
KONTRA_ORCHESTRATOR_URL=http://host.docker.internal:8088

# ── tokens ───────────────────────────────────────────────────────────────────────────────────────
#
# These are also in ~/.kontra/config.yaml, which is where the CLI reads them. THE TWO MUST AGREE:
# this file is what a container gets, that file is what the CLI gets, and a mismatch is a 401 on one
# side only.

# Raw actor state and the infra routes — the ones that create and DESTROY Machines, so the ones that
# spend money. DISABLED when blank: those routes answer 503 `disabled: set KONTRA_STATE_TOKEN`.
# A blank here once stranded four running Droplets that `kontra fleet down` could not destroy.
KONTRA_STATE_TOKEN=

# serve, start, stop, and a Dataset's tag and rename.
# **OPEN WHEN BLANK** — anything that can reach the API can run a workflow from the checkout,
# including one that provisions cloud machines, and can untag a Dataset, which hands it to the
# retention sweep one tick later. Leave it blank only if you mean that.
KONTRA_RUN_TOKEN=

# Mints Dashboard WebSocket tickets, and nothing else. The browser never holds it.
# DISABLED when blank: every panel route answers 503 and the Dashboard is a blank rectangle.
KONTRA_PANEL_TOKEN=

# The query workbench's presigned reads. Falls back to the state token when blank, which is why
# `kontra init` leaves this one alone.
KONTRA_EXPLORE_TOKEN=

# ── the console login ────────────────────────────────────────────────────────────────────────────

# Base64 of a JSON array of {name, password_hash} — the accounts that may sign in to the console
# (ADR 0045). Generated by `kontra init` / `kontra user add`; only scrypt hashes, never a password.
#
# Base64 because the hash contains `$` and compose substitutes `$` in values it passes through: the
# raw form arrives corrupted into something that still LOOKS like a hash, so every login fails as
# "wrong password" rather than as the configuration error it is.
#
# Blank means nobody can sign in — the console then steps aside rather than showing a form nobody
# can pass, which is the pre-login behaviour preserved.
KONTRA_CONSOLE_USERS=

# ── data ─────────────────────────────────────────────────────────────────────────────────────────

# NO DEFAULT IN COMPOSE. Absent means the substitution is empty and the mount is wrong.
KONTRA_DATA_DIR=./.kontra-data
KONTRA_ORCHESTRATOR_DB=/data/orchestrator.sqlite

# The DuckLake catalog's Postgres password, shared by the API and the materializer — they must read
# the catalog the other writes.
KONTRA_DUCKLAKE_PASSWORD=

# ── the fleet, and the credentials that spend money ──────────────────────────────────────────────
#
# ONLY orchestrator-infra should ever hold these. Every one is blank here; a fleet is not something
# this file should be able to create by being copied.

# The cloud credential. Creates and destroys Machines, with no ceiling.
DIGITALOCEAN_TOKEN=
KONTRA_CLOUD_CREDENTIAL=

# Encrypts Pulumi's state secrets. Lose it and the stack's secrets are unreadable; leak it and every
# stored secret is readable. Back it up somewhere that is not this file.
PULUMI_CONFIG_PASSPHRASE=

# The private key the Controller reaches its Machines with.
KONTRA_FLEET_SSH_KEY=~/.ssh/axiom_rsa

# WHERE a fleet is provisioned. Blank leaves the orchestrator's own defaults.
# SET THE REGION AND LEAVE THE VPC BLANK unless you have a specific one: a VPC is REGIONAL, so a
# region from here with a VPC from elsewhere is the one combination the provider refuses.
KONTRA_FLEET_REGION=
KONTRA_FLEET_VPC=
KONTRA_FLEET_SIZE=
KONTRA_FLEET_IMAGE=
# Provider SSH KEY IDS (not paths), comma-separated. Account-scoped: another account's ids produce
# Machines nobody can log into, and nothing reports it until a Terminal is opened.
KONTRA_FLEET_SSH_KEY_IDS=

# ── panels (ADR 0020) ────────────────────────────────────────────────────────────────────────────

# Origins the panels streamer will accept a browser from. Widening this is widening who may open a
# Terminal onto a live process.
KONTRA_PANEL_ORIGIN=http://localhost:8088
KONTRA_PANEL_SNAPSHOT_MS=3000

# Where tmux keeps its socket. The streamer and the CLI must agree, or `kontra panels list` finds
# a server that is running and reports nothing.
TMUX_TMPDIR=/tmp

# ── queues ───────────────────────────────────────────────────────────────────────────────────────

KONTRA_PROBE_QUEUE=kontra-probe

# ── Temporal TLS — environment only, deliberately no key in config.yaml ──────────────────────────
#
# The same five are read by the orchestrator, both Python hosts and every Go binary. A value that
# also lived in config.yaml would be a second policy that agrees today and drifts later.
# UNSET IS PLAINTEXT, which is what a local install wants. ANY ONE of them turns TLS on.
#
#   KONTRA_TEMPORAL_TLS              1|true|yes|on — TLS with the system trust store
#   KONTRA_TEMPORAL_TLS_CA           PEM path: the server's root CA, for a private CA
#   KONTRA_TEMPORAL_TLS_CERT         PEM path: this client's certificate   ] both, or neither
#   KONTRA_TEMPORAL_TLS_KEY          PEM path: this client's private key   ]
#   KONTRA_TEMPORAL_TLS_SERVER_NAME  SNI override, for a proxy in front of the server
