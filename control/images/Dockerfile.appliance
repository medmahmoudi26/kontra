# The whole control plane, in one container — the compose install path.
#
# ── WHAT THIS IS, AND WHAT IT IS NOT ────────────────────────────────────────────────────────────
#
# It is `kontra up` with Docker as the supervisor instead of your shell. One process inside: Temporal,
# the object store, the state store, the payload codec, the OCI registry and the orchestrator as its
# supervised child (ADR 0031). Nothing is disassembled to fit in here.
#
# IT IS NOT THE OLD COMPOSE TOPOLOGY COMING BACK. Nine services left `docker-compose.yml` one slice
# at a time and every one of those departures fixed a bug that is written down where the service used
# to be: a `chown` sidecar for a root-owned named volume, a one-shot that created an S3 bucket
# because a missing one answers `403 AccessDenied`, a dynamic-config key the server never registered.
# Re-splitting the appliance into containers would reintroduce all three. Putting the appliance IN a
# container reintroduces none of them, because inside here it is still one process writing its own
# files in its own directory.
#
# ── WHY THE IMAGE IS BUILT FROM A RELEASE TARBALL AND NOT FROM SOURCE ───────────────────────────
#
# `kontra release` produces exactly what a user downloads: the binary, its orchestrator bundle and
# the browser bundle, laid out where `findBundles` looks. Building the image FROM that artifact means
# the container and the download are the same bytes — which is the whole of "verify our builds". A
# Dockerfile that compiled from source would be a second build, with its own toolchain and its own
# ways to differ, testing something nobody ships.
#
#   cd cli && go run . release --repo .. --platform linux/amd64 --out ../build/release
#   docker build -f control/images/Dockerfile.appliance \
#                --build-arg TARBALL=build/release/kontra_0.1.0_linux_amd64.tar.gz -t kontra .
#
# `make image` does both.
#
# ── DEBIAN, NOT ALPINE, AND IT IS NOT A PREFERENCE ──────────────────────────────────────────────
#
# The Go binary is cgo-free and would run anywhere. The ORCHESTRATOR BUNDLE CARRIES ITS OWN NODE, and
# that Node is a glibc build from nodejs.org — on musl it does not start, and the failure is
# `no such file or directory` about a file that is plainly there, which is the least informative
# error in this whole system. The appliance hydrates that bundle at first boot, so the failure would
# arrive on first run rather than at build.

ARG BASE=debian:bookworm-slim
FROM ${BASE}

# ca-certificates ONLY, and it is load-bearing rather than habit: the appliance reaches a registry,
# an object store and (for a Fleet) a cloud API over TLS, and a container with no root store fails
# every one of them with a certificate error that reads like a misconfiguration at the far end.
# `tzdata` because a Run's timestamps are rendered by the console and a UTC-only container makes
# every local time in a transcript an hour or several wrong depending on who is reading it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*

# THE CNB `pack` BINARY, PINNED AND CHECKSUMMED (ADR 0061).
#
# `kontra deploy` builds actor images with Cloud Native Buildpacks, which means the lifecycle, which
# means `pack`. It is a BINARY and not a Go module on purpose: importing pack pulls its whole
# dependency graph into a CLI that also ships as a single download, and this image is the one place
# that needs it.
#
# THE CHECKSUM IS THE POINT OF PINNING, not the version string. A tag can be re-pointed; a build that
# silently used a different lifecycle than the one this was tested against would produce actor images
# whose layers do not match what the catalog records. Verified rather than trusted, because the
# download is over the network at image-build time.
#
# BOTH CHECKSUMS, EACH NAMED FOR WHAT IT COVERS. `kontra-runtimes/builder.json` records two for this
# release — one for the tarball and one for the `pack` binary inside it — and they are both 64 hex
# characters, so nothing about either value says which is which. This verified /tmp/pack.tgz against
# the BINARY's digest and failed every build with `/tmp/pack.tgz: FAILED`, a message that reads like
# a corrupted download or a re-pointed release. Checking both, under names, makes a swap fail on the
# first line and say so. Verified against the real release on 2026-10-08.
ARG PACK_VERSION=0.40.9
ARG PACK_TARBALL_SHA256=dc0ee1e931cf8a106d7555a01a214864f9acb60b77adf15d69b74df4404758e9
ARG PACK_BINARY_SHA256=2f85c3ec624f73f2d3c4a680a2c48fe6755197844730cc4ea5ed05f950fe05a3
ADD https://github.com/buildpacks/pack/releases/download/v${PACK_VERSION}/pack-v${PACK_VERSION}-linux.tgz /tmp/pack.tgz
RUN printf '%s  /tmp/pack.tgz\n' "${PACK_TARBALL_SHA256}" | sha256sum -c - \
 && tar -xzf /tmp/pack.tgz -C /usr/local/bin pack \
 && printf '%s  /usr/local/bin/pack\n' "${PACK_BINARY_SHA256}" | sha256sum -c - \
 && rm /tmp/pack.tgz \
 && /usr/local/bin/pack --version

# THE RELEASE ARTIFACT, WHOLE. The path is a build arg rather than a fixed name because the file is
# named for its version and platform, and hard-coding either is how an image quietly keeps shipping
# last month's binary.
ARG TARBALL
COPY ${TARBALL} /tmp/kontra.tar.gz

# UNPACKED THE WAY `install.sh` UNPACKS IT: the binary onto PATH, the rest into KONTRA_HOME. That
# equivalence is the point — an operator debugging this container is looking at the same tree they
# would have on a laptop, in the same places, so every path in every error message means the same
# thing in both.
ENV KONTRA_HOME=/var/lib/kontra
RUN set -eux; \
    mkdir -p /tmp/unpack "${KONTRA_HOME}"; \
    tar -xzf /tmp/kontra.tar.gz -C /tmp/unpack; \
    install -m 0755 /tmp/unpack/kontra /usr/local/bin/kontra; \
    cp -r /tmp/unpack/bundles "${KONTRA_HOME}/bundles"; \
    if [ -d /tmp/unpack/manifests ]; then cp -r /tmp/unpack/manifests "${KONTRA_HOME}/manifests"; fi; \
    rm -rf /tmp/kontra.tar.gz /tmp/unpack; \
    kontra --version

# WHERE STATE LIVES — and the volume is the WHOLE HOME, not just `data/`.
#
# Temporal's history, the objects, `global_state` and the lake's catalog are under `data/`; a
# container recreated without them is a control plane that has forgotten every run. But `config.yaml`
# is a sibling of `data/`, not a child — it holds the console account and the four service tokens
# that `kontra init` generates on first boot — and a volume mounted one level deeper would lose it
# on every recreate, rotating the password out from under whoever wrote it down.
#
# MOUNTING THE HOME KEEPS THE BUNDLES TOO. Docker seeds a FRESH named volume from the image's
# contents, so `bundles/` — unpacked above — is copied in on first use and the orchestrator hydrates
# from it exactly as it would without a volume. Mounting a sub-path would have been the smaller
# change and the wrong one.
ENV KONTRA_DATA_DIR=/var/lib/kontra/data
VOLUME ["/var/lib/kontra"]

# ── ROOT, DELIBERATELY, AND THE REASON IS THE SERVICE THAT USED TO DO THIS BY HAND ──────────────
#
# `temporal-data-owner` existed in the old compose file for one job: `chown -R 1000:1000` a Docker
# named volume, because Docker creates one root-owned and `temporalio/temporal` ran as uid 1000. On
# the very first `up` and only then, SQLite could not create its database and reported it as
# `unable to open database file: out of memory (14)` — error 14 is CANTOPEN and the "out of memory"
# text is SQLite's generic string for it, which is a lie about the cause. MEASURED on a fresh 8 GB
# droplet with 7.9 GB free.
#
# That service was deleted rather than fixed, because the appliance creates its own files as whoever
# ran it. Running as root here keeps that true: the process uid and the volume's owner are the same
# by construction, so there is no mismatch for a sidecar to paper over. A `user:` in compose is
# supported and is the operator's to choose — with a `chown` of their own, which is the trade that
# service documented.

EXPOSE 8088 7233 8333 6379 18234 5000

# `--bind 0.0.0.0` BECAUSE THE BIND IS INSIDE A NETWORK NAMESPACE. On a host, the bind address is the
# security control and `kontra up` defaults to loopback for exactly that reason. In here it is not:
# what is reachable is decided by compose's `ports:` mapping, and a loopback bind would make every
# published port answer nothing. So the container binds wide and `docker-compose.yml` publishes each
# port to `${KONTRA_BIND}` — which defaults to `127.0.0.1` and is the one place to widen it.
#
# THIS IS THE TRAP `docker-bypasses-ufw` NAMES: a published port is DNATed in PREROUTING and accepted
# in FORWARD, so it never traverses `ufw-user-input` and a host firewall will not save you. The
# publish address is the control. It is in `.env` and it is documented there.
# FIRST BOOT INITIALISES, EVERY BOOT AFTER IT STARTS. `kontra init` generates the console login and
# prints it ONCE — to the container log, which is where `docker compose logs kontra` looks and the
# only place it can go in an install nobody is attached to. See the script; it is twenty lines and
# most of them are why.
COPY control/images/entrypoint.sh /usr/local/bin/kontra-entrypoint
COPY examples/python/hello /opt/kontra/seed/actors/hello
COPY examples/workflows/hello /opt/kontra/seed/workflows/hello
COPY sdk/python /opt/kontra/sdk/python
COPY runtime/python /opt/kontra/runtime/python
RUN chmod +x /usr/local/bin/kontra-entrypoint \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker.io python3 python3-pip python3-venv \
 && pip3 install --break-system-packages --no-cache-dir temporalio redis boto3 pydantic \
 && rm -rf /var/lib/apt/lists/*

# ── THE DuckDB CLI, BECAUSE THIS IMAGE IS ALSO AN `spa-src` ─────────────────────────────────────
#
# `Dockerfile.selfcontained` installs this and explains at length why the version is pinned to the
# orchestrator's `@duckdb/node-api`: two engines, one DuckLake catalog, and a catalog format
# versioned with DuckDB, so the older of the two refuses what the newer wrote. Read that comment;
# this is the same decision and `tests/test_duckdb_pin.py` holds all of them to one version.
#
# IT IS HERE BECAUSE `Dockerfile.orchestrator:77` IS `COPY --from=spa-src /usr/local/bin/duckdb`,
# AND THIS FILE CAN BE THAT `spa-src`. `make image` tags `selfcontained` as the kontra image and
# `publish.yml`/`make image-from-release` tag THIS one, so "the kontra image" is two files and only
# one of them carried duckdb. MEASURED on `0.0.0-test6`: `kontra`, `kontra-host` and
# `kontra-logship` pushed, then the orchestrator build died with
#
#     ERROR: failed to calculate checksum of ref …: "/usr/local/bin/duckdb": not found
#
# The pin test checked both ENDS of that chain — selfcontained installs it, orchestrator copies it —
# and never that they were the same chain, which is why a green suite said nothing. It now asserts
# every file that can serve as `spa-src`.
ARG TARGETARCH
ARG DUCKDB_VERSION=1.5.4
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) duckarch=amd64 ;; \
      arm64) duckarch=arm64 ;; \
      *) echo "no duckdb build for TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl unzip; \
    curl -fsSL -o /tmp/duckdb.zip \
      "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb_cli-linux-${duckarch}.zip"; \
    unzip -q /tmp/duckdb.zip -d /tmp/duckdb; \
    install -m 0755 /tmp/duckdb/duckdb /usr/local/bin/duckdb; \
    rm -rf /tmp/duckdb /tmp/duckdb.zip; \
    rm -rf /var/lib/apt/lists/*; \
    duckdb --version
ENV PYTHONPATH=/opt/kontra/sdk/python:/opt/kontra/runtime/python
ENV KONTRA_SDK_ROOT=/opt/kontra
CMD ["kontra", "version"]
ENTRYPOINT ["/usr/local/bin/kontra-entrypoint"]
