FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip docker.io \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL https://get.pulumi.com | sh
ENV PATH="/root/.pulumi/bin:${PATH}"

WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY shared/core ./shared/core
COPY shared/conformance ./shared/conformance
COPY control/orchestrator ./control/orchestrator
RUN corepack enable \
 && pnpm install --frozen-lockfile \
 && pnpm --filter @kontra/core run build \
 && pnpm --filter @kontra/backend run build \
 && pulumi plugin install resource docker \
 && pulumi plugin install resource digitalocean \
 && pulumi plugin install resource command

WORKDIR /src/control/orchestrator
ENV NODE_ENV=production
COPY control/images/orchestrator-entrypoint.sh /usr/local/bin/orchestrator-entrypoint
RUN chmod +x /usr/local/bin/orchestrator-entrypoint
ENTRYPOINT ["/usr/local/bin/orchestrator-entrypoint"]
