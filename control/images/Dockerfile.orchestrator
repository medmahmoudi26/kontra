# Console bytes come from the `kontra` image (`make image` writes bundles/kontra-spa.tar.gz).
ARG SPA_IMAGE=kontra:latest
FROM ${SPA_IMAGE} AS spa-src

FROM node:22-bookworm-slim

# python3 is here for ONE reason: `serve`. A served workflow Worker is `python3 workflow.py`, and
# serve-dev runs THIS IMAGE as the Worker's container — the SDK at /opt/kontra below is what that
# container imports, which is why the interpreter and the SDK have to be in the same image as the
# CLI that starts it (`cli/warden/driver_dev.go`).
#
# tmux WAS HERE TOO and is deliberately not any more. `kontra serve --tmux` put the Worker in a
# detached session on this container's tmux server so the Monitor's `list-panes` could find it. The
# Monitor is gone, the session is a container, and the shared socket that let this container and
# orchestrator-infra reach each other's processes went with it (see docker-compose.yml's header).
#
# procps because this container HOSTS those workers. Without it `ps` does not exist here, so the
# first question anyone asks of a Worker that looks wrong — is the process still alive — has no
# answer from inside.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip docker.io python3 procps \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL https://get.pulumi.com | sh
ENV PATH="/root/.pulumi/bin:${PATH}"

WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY shared/core ./shared/core
COPY shared/conformance ./shared/conformance
COPY control/orchestrator ./control/orchestrator
# ── THE PLUGIN VERSIONS COME FROM THE INSTALLED SDKs, NOT FROM "latest" ─────────────────────────
#
# `pulumi plugin install resource docker` with no version asks the GitHub API for the newest release,
# ANONYMOUSLY. On a shared CI runner that is a rate limit somebody else already spent:
#
#     error: Unable to resolve package from name: unable to get the latest version of "docker":
#     rate limit exceeded: 403 HTTP error fetching plugin from
#     https://api.github.com/repos/pulumi/pulumi-docker/releases/latest
#
# MEASURED on `0.0.0-test8`, where `images arm64` installed all three and pushed five images while
# `images amd64` was refused on the first one. Two arches of the same commit, one build reproducible
# and the other not — which is the shape a rate limit always takes and the reason it cannot be
# retried away.
#
# AND "latest" WAS WRONG EVEN WHEN IT WORKED. The SDK is pinned in `package.json` (`@pulumi/docker`,
# `@pulumi/digitalocean`, `@pulumi/command`) and the plugin is the binary provider that SDK drives, so
# resolving the plugin separately lets the image ship a provider the code was never written against.
#
# SO THE VERSION IS READ OUT OF THE SDK THAT WAS JUST INSTALLED. `pnpm install --frozen-lockfile` has
# already resolved the lockfile by this point, so `require('@pulumi/docker/package.json').version` is
# the exact version this image will drive — one decision in one place, no API call, and no second file
# to forget. `control/pulumi/Pulumi.yaml`'s own plugin pins are a separate harness and `parity.py` is
# what keeps the two honest.
#
# THE npm VERSION IS THE RIGHT SOURCE FOR THESE THREE, CHECKED RATHER THAN ASSUMED. Some Pulumi SDKs
# ship a `pulumi-plugin.json` naming the plugin version independently of the package version, and that
# file would be the authority where it exists. None of these three ships one — verified against the
# installed tree at 4.11.2 / 4.78.1 / 1.2.1, all of which are real plugin releases. If a future SDK
# starts shipping it, read it here in preference.
RUN corepack enable \
 && pnpm install --frozen-lockfile \
 && pnpm --filter @kontra/core run build \
 && pnpm --filter @kontra/backend run build \
 && cd control/orchestrator \
 && for p in docker digitalocean command; do \
      v=$(node -p "require('@pulumi/$p/package.json').version") \
        || { echo "no @pulumi/$p installed — the plugin version is read from the SDK" >&2; exit 1; }; \
      echo "==> pulumi plugin install resource $p v$v (from @pulumi/$p)"; \
      pulumi plugin install resource "$p" "$v"; \
    done

WORKDIR /src/control/orchestrator
ENV NODE_ENV=production
COPY control/images/orchestrator-entrypoint.sh /usr/local/bin/orchestrator-entrypoint
RUN chmod +x /usr/local/bin/orchestrator-entrypoint

# A `kontra` image built with no console has no archive; GET / then 404s and /api still works.
COPY --from=spa-src /var/lib/kontra/bundles /tmp/kontra-bundles
RUN mkdir -p web/dist \
 && if [ -f /tmp/kontra-bundles/kontra-spa.tar.gz ]; then \
      tar -xzf /tmp/kontra-bundles/kontra-spa.tar.gz -C /tmp \
      && cp -a /tmp/web/dist/. web/dist/ \
      && test -f web/dist/index.html; \
    fi \
 && rm -rf /tmp/kontra-bundles /tmp/web /tmp/manifest.json

# ── WHAT `serve` RUNS, TAKEN FROM THE `kontra` IMAGE RATHER THAN REBUILT ────────────────────────
#
# `serveWorkflow` (control/orchestrator/src/workflowControl.ts) shells out to the CLI instead of
# reimplementing it, and `createWorkspace` (workspaces.ts) seeds from /opt/kontra/seed. Neither
# path existed in this image, so both failed at runtime with nothing to point at: serve answered
# `spawn kontra ENOENT` and a console-created workspace answered
# `seed templates not found at /opt/kontra/seed` AFTER making the directory.
#
# COPIED FROM `spa-src`, NOT REINSTALLED. The CLI container serves with these exact bytes — the
# same binary, the same SDK tree, the same pinned wheels — so a worker started from the console and
# one started with `docker compose exec cli` cannot be running different code. A second
# `pip install temporalio redis boto3 pydantic` here would be unpinned in two images and drift on
# whichever is rebuilt next; that drift is a worker that dials a queue nobody else agrees on.
#
# Debian bookworm on both sides (node:22-bookworm-slim and debian:bookworm-slim), so python3.11 and
# `/usr/local/lib/python3.11/dist-packages` mean the same thing in both. The RUN below is the check
# that says so AT BUILD TIME rather than on the operator's first click.
COPY --from=spa-src /usr/local/bin/kontra /usr/local/bin/kontra
# `pack` COMES WITH IT, BECAUSE THE INFRA ROLE IS WHAT RUNS `kontra deploy`.
# `src/activities/buildActor.ts` spawns it here — this is the only role holding the Docker socket —
# and `kontra deploy` is `pack` now (ADR 0061). Without this the console's build path fails with
# `no pack binary`, which reads as a missing dependency on the operator's machine rather than a
# missing layer in this image. Taken from `spa-src` and not re-downloaded, so the two images cannot
# disagree about which lifecycle built an actor.
COPY --from=spa-src /usr/local/bin/pack /usr/local/bin/pack
# THE CLI'S OTHER HALF. `serveWorkflow` spawns `kontra` in THIS container, and a workflow that
# reaches a dataset verb shells out to `duckdb` (cli/runs.go:duckdbBin) — so shipping the CLI
# without it is shipping a binary that fails on a subset of its own commands. Copied rather than
# downloaded again so both images carry the SAME build: the version is pinned to the embedded
# `@duckdb/node-api` because they share one DuckLake catalog — see Dockerfile.selfcontained.
COPY --from=spa-src /usr/local/bin/duckdb /usr/local/bin/duckdb
COPY --from=spa-src /opt/kontra /opt/kontra
COPY --from=spa-src /usr/local/lib/python3.11/dist-packages /usr/local/lib/python3.11/dist-packages
ENV KONTRA_SDK_ROOT=/opt/kontra
# THIS IMAGE BUILDS ACTORS TOO — `src/activities/buildActor.ts` spawns `kontra deploy` — so it needs
# everything that stages into an actor image, not only what it runs itself. The handler and BOTH
# Python trees: the SDK's pyproject maps `internals = "../../runtime/python/internals"`, so one
# without the other produces an image whose `import kontra` fails at load() on a Machine.
RUN kontra --version \
 && python3 -c 'import temporalio, redis, boto3, pydantic, yaml' \
 && test -f /opt/kontra/seed/workflows/hello/workflow.py \
 && test -d /opt/kontra/sdk/python/kontra \
 && test -d /opt/kontra/runtime/python/internals \
 && test -x /opt/kontra/handler

ENTRYPOINT ["/usr/local/bin/orchestrator-entrypoint"]
