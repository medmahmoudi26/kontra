# The whole thing, built in Docker. `docker` is the only prerequisite.
#
# ── NOTHING IS BUILT ON THE HOST, AND THAT IS NOT JUST CONVENIENCE ──────────────────────────────
#
# Building the SPA, the Go binary and both pnpm installs on the host would make "install kontra with
# Docker" quietly require Go, Node, pnpm and a working workspace before Docker did anything.
#
# IT IS ALSO A CORRECTNESS PROBLEM ON macOS. The console has ten pairs of files
# whose names differ only in case — `WorkflowThread.tsx` beside `workflowThread.ts`, and nine more.
# On a case-sensitive filesystem those are two modules. On the case-INSENSITIVE one macOS gives you
# by default, `tsc` resolves `./WorkflowThread` to both and stops with 102 errors about names that
# "differ only in casing". The files are fine; the host's filesystem is not.
#
# Building here fixes it by construction: the sources are COPIED onto this image's own layer, which
# is case-sensitive, so the compiler sees exactly what Linux CI sees. Nothing about the console had
# to change, and nothing about your laptop has to either.
#
# ── THE CONTEXT IS THE PARENT DIRECTORY, AND IT HAS TO BE ───────────────────────────────────────
#
#   kontra-local/
#     ├── kontra/            <- this repository
#     └── kontra-console/    <- the SPA (ADR 0038)
#
#   docker build -f kontra/control/images/Dockerfile.selfcontained -t kontra:latest kontra-local/
#
# The console resolves `@kontra/core` as `link:../kontra/shared/core` — a filesystem path, not a
# published package — so both directories must be visible to ONE build and both names are
# load-bearing. `make image` does this for you.
#
# ── EVERY COPIED `node_modules` IS DELETED, AND THAT IS NOT TIDINESS ────────────────────────────
#
# The build context is the parent directory, so a `.dockerignore` at the repo root does not apply
# to it, and both checkouts arrive with whatever their host installs left behind. On a Mac that is
# a darwin-arm64 tree — including `@temporalio/core-bridge`, which is a native addon — and it would
# SHADOW the linux install done below. The failure would be at runtime, inside the container, about
# a `.node` file that is plainly there. So each stage purges before it installs.

# ── 1 · THE BROWSER BUNDLE ──────────────────────────────────────────────────────────────────────
#
# Node 22 because that is `engines.node` for the orchestrator that will serve this bundle
# (control/orchestrator/package.json). A SPA built on a different major than the one that serves it
# is a difference with nowhere to show up until runtime.
FROM node:22-bookworm AS spa

# corepack ships with Node and takes pnpm's version from the lockfile, so there is no pnpm pinned
# in two places waiting to disagree.
RUN corepack enable
WORKDIR /src

# BOTH TREES, WHOLE. A layer-cached manifests-first install was the first shape of this and it was
# wrong twice over: building `@kontra/core` reads `shared/conformance` (the corpus three SDKs are
# checked against) and the console's `tsc --noEmit` covers `e2e/`, which imports the orchestrator's
# source across the repo boundary. Copying "just the package being built" is the obvious thing and
# it is wrong by two directories.
COPY kontra ./kontra
COPY kontra-console ./kontra-console

# See the header: a host's node_modules must never survive into a linux install.
RUN rm -rf kontra/node_modules kontra/*/node_modules kontra/*/*/node_modules \
           kontra-console/node_modules kontra-console/dist

# ── THE CACHE ID IS PER STAGE, AND THAT IS A DEADLOCK FIX ──────────────────────────────────────
#
# These three mounts all named the same cache (no `id=`, so the id defaults to the target path) with
# `sharing=locked`. `spa` and `release` are independent stages, so BuildKit schedules them
# CONCURRENTLY, and both then block on one lock. MEASURED 2026-09-29, on both the docker-container
# and the docker driver, with 5.2 GB free and an idle box:
#
#     #22 [release  8/12] RUN --mount=type=cache,target=/pnpm-store,sharing=locked  … pnpm install …
#     #24 [spa      7/10] RUN --mount=type=cache,target=/pnpm-store,sharing=locked  … pnpm install …
#
# and neither ever produced another line. It worked for months because a WARM store made each
# install short enough that the lock was held briefly; it started hanging the first time the store
# was empty (after a `docker builder prune -af`), which is also the state of any fresh machine —
# so this was a first-build-on-a-clean-host failure waiting to happen, not a local accident.
#
# Per-stage ids keep the cross-BUILD caching that made the mounts worth having, and remove the
# cross-STAGE contention entirely. `sharing=locked` still serialises concurrent builds of the SAME
# stage, which is the case it was actually there for.
RUN --mount=type=cache,id=pnpm-spa,target=/pnpm-store,sharing=locked \
    cd kontra && pnpm config set store-dir /pnpm-store && pnpm install --frozen-lockfile
RUN cd kontra && pnpm --filter @kontra/core run build

# THE CONSOLE'S INSTALL NEEDS `../kontra/shared/core/dist` TO EXIST ALREADY, because `link:` is
# resolved at install time and its types are read by the typecheck immediately after.
RUN --mount=type=cache,id=pnpm-spa,target=/pnpm-store,sharing=locked \
    cd kontra-console && pnpm config set store-dir /pnpm-store && pnpm install --frozen-lockfile

# `pnpm run build` is `tsc --noEmit && vite build`. THE TYPECHECK STAYS. It is the step that fails
# on a case collision, and dropping it to make this Dockerfile quieter would hide exactly the class
# of bug this file exists to sidestep. `test -f` because a vite build that emitted nothing still
# exits 0 if its input was empty.
RUN cd kontra-console && pnpm run build && test -f dist/index.html

# ── 2 · THE BINARY AND ITS BUNDLES ──────────────────────────────────────────────────────────────
#
# Two Go binaries and one archive come out of this stage: the `kontra` CLI, the workflow `handler`,
# and the browser bundle packed where `Dockerfile.orchestrator` reads it. Nothing is staged, packed
# and unpacked on the way — a tarball in the middle of a single build is a step that can only lose
# bytes.
FROM golang:1.25-bookworm AS release

# THE ARCHITECTURE IS THE BUILD'S, NOT A LITERAL. `TARGETARCH` is set by the builder — `arm64` on an
# Apple Silicon Mac, `amd64` on an Intel one or a Linux box — and everything below has to agree with
# it. A literal `linux/amd64` here cross-builds an amd64 binary into an arm64 runtime image: a
# container that pulls fine and answers `exec format error` on first run.
ARG TARGETARCH

# The repo pins Go 1.26.9 in `go.work`. GOTOOLCHAIN makes the toolchain in this image fetch and
# verify that exact one rather than whatever the base ships — the mechanism Go added for this, and
# the same version `install.sh` fetches on a bare machine. `cli/gotoolchain_test.go` asserts every
# copy of the version agrees with `go.work`; there are seven, and a bump that lands in go.mod alone
# breaks only the container paths.
ENV GOTOOLCHAIN=go1.26.9
ENV CGO_ENABLED=0

# NO NODE AND NO PNPM IN THIS STAGE. Two Go binaries come out of it and neither is built with a
# JavaScript toolchain; the orchestrator is compiled in `Dockerfile.orchestrator`, which is where it
# runs. A pnpm install here cost minutes and produced nothing this stage copies out.
WORKDIR /src/kontra
COPY kontra ./
RUN rm -rf node_modules ./*/node_modules ./*/*/node_modules

# THE SPA COMES FROM STAGE 1, not from the host. A `dist/` that happened to be lying around in the
# checkout is somebody's older build, and archiving it would put a stale console in a fresh image.
COPY --from=spa /src/kontra-console/dist /src/console-dist

# `0.0.0-docker` says "built from a working tree", which is what an untagged `latest` actually is.
# `make image` passes the git describe.
ARG VERSION=0.0.0-docker
# TARGETARCH IS A BUILDKIT VARIABLE, so it is empty under the legacy builder. Refuse here, naming
# the fix, rather than letting an empty arch surface as a confusing failure further down.
RUN test -n "${TARGETARCH}" || { \
      echo "TARGETARCH is empty — this build needs BuildKit. Run it with DOCKER_BUILDKIT=1, or update Docker."; \
      exit 1; }

# ── CACHE MOUNTS, BECAUSE THE CACHES MUST NOT BECOME LAYERS ─────────────────────────────────────
#
# Compiling this pulls ~2.5 GB of Go modules and writes ~3 GB of build cache. Without these mounts
# every byte of that is written into the container filesystem AND THEN COMMITTED INTO A LAYER — so
# the build needs roughly twice the disk it should, and the image carries caches nothing at runtime
# will ever read.
#
# MEASURED, twice, on two different machines: `no space left on device` partway through the Temporal
# server compile — once on a Linux box with 4 GB free, once inside Docker Desktop's VM on a Mac. A
# cache mount lives in BuildKit's own store instead: not in a layer, and REUSED by the next build,
# so a second `make image` does not re-download a single module.
#
# The trade is that `docker builder prune` is now where that space is reclaimed from, which is also
# the answer when a machine does run out.
# THE BINARY, BUILT DIRECTLY. `-trimpath` so the paths in a panic are the module's rather than this
# container's, and the version is linked in so `kontra version` reports what was built rather than
# what a working tree looked like.
#
# THE LDFLAGS TARGET IS THE WHOLE SYMBOL PATH, AND A WRONG ONE IS SILENT. `-X` on a symbol that does
# not exist is dropped without an error, so `buildinfo.version` stays empty and the image reports a
# dev version. `buildinfo.LinkerFlag` spells the one target out.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    mkdir -p /out \
 && cd cli && go build -trimpath \
      -ldflags "-s -w -X github.com/medmahmoudi26/kontra/cli/internal/buildinfo.version=${VERSION}" \
      -o /out/kontra . \
 && /out/kontra version

# THE CONSOLE, AS THE ONE ARCHIVE `Dockerfile.orchestrator` READS.
#
# That image is `FROM ${SPA_IMAGE} AS spa-src` and untars `bundles/kontra-spa.tar.gz`, expecting
# `web/dist/` inside it (Dockerfile.orchestrator:78-84). The member prefix is therefore part of the
# contract between the two images and not a detail of how this one happens to pack: `tar -C /stage
# web/dist` is what puts it there.
RUN mkdir -p /stage/web/dist /out/bundles \
 && cp -a /src/console-dist/. /stage/web/dist/ \
 && test -f /stage/web/dist/index.html \
 && tar -czf /out/bundles/kontra-spa.tar.gz -C /stage web/dist

# THE HANDLER, COMPILED ONCE — the workflow half of a Worker, which `kontra serve --mode local`
# used to run as `go run .` out of `runtime/handler`. That is right in a checkout and impossible in
# the control plane: this image has no Go toolchain and no sources, so the Actors page's Serve
# button (which runs `kontra serve` inside orchestrator-api) could only ever fail. Same build flags
# as a Machine's own build, so the handler a locally served actor runs and the one a Machine runs
# are the same binary.
#
# NOT into /out: the runtime stage below unpacks /out and then deletes it.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    cd runtime/handler && GOWORK=off go build -p=1 -trimpath -o /handlerbin/handler .

# ── 3 · WHAT ACTUALLY RUNS ──────────────────────────────────────────────────────────────────────
#
# Debian rather than Alpine: this image carries glibc-linked Node and Python wheels, and on musl
# they do not start — the failure is `no such file or directory` about a file that is plainly there.
FROM debian:bookworm-slim
ARG TARGETARCH

# ca-certificates is load-bearing rather than habit: this container reaches a registry, an object
# store and (for a Fleet) a cloud API over TLS, and one with no root store fails every one of them
# with a certificate error that reads like a fault at the far end. tzdata because a Run's
# timestamps are rendered by the console, and a UTC-only container makes every local time in a
# transcript wrong by however far the reader is from Greenwich.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata curl unzip \
 && rm -rf /var/lib/apt/lists/*

# ── THE DuckDB CLI, AND WHY ITS VERSION IS PINNED TO A NODE PACKAGE ─────────────────────────────
#
# THERE ARE TWO DuckDB ENGINES IN THIS SYSTEM AND THEY SHARE ONE CATALOG.
#
#   the orchestrator  embeds `@duckdb/node-api` (control/orchestrator/package.json) — this is what
#                     answers `/api/datasets/:name/preview` and the query workbench
#   the CLI           SHELLS OUT to a `duckdb` binary on PATH (cli/runs.go:duckdbBin) — this is what
#                     `kontra dataset create|query|anew` runs
#
# Both open the SAME DuckLake catalog, and **DuckLake's catalog format is versioned with DuckDB**.
# So the binary is not "some duckdb", it is the one that can read what the embedded engine wrote.
#
# MEASURED, not assumed. Against a catalog this stack's embedded 1.5.4 had created:
#
#   duckdb 1.1.3  HTTP 404 fetching the `ducklake` extension — the extension does not exist for it
#   duckdb 1.3.2  "Not implemented Error: Only DuckLake versions 0.1 and 0.2 are supported"
#   duckdb 1.5.x  works
#
# WITHOUT THIS THE IMAGE SHIPPED NO duckdb AT ALL, and every CLI dataset verb failed with
# "duckdb not found on PATH — install it and retry" — an install instruction inside a container
# whose whole promise is that Docker is the only prerequisite.
#
# KEEP DUCKDB_VERSION AND `@duckdb/node-api` IN STEP. They are one decision written in two files;
# `tests/test_duckdb_pin.py` fails if they drift, because the failure they cause otherwise is a
# catalog error at the far end of a dataset write, not a version mismatch anybody can see.
ARG DUCKDB_VERSION=1.5.4
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) duckarch=amd64 ;; \
      arm64) duckarch=arm64 ;; \
      *) echo "no duckdb build for TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/duckdb.zip \
      "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb_cli-linux-${duckarch}.zip"; \
    unzip -q /tmp/duckdb.zip -d /tmp/duckdb; \
    install -m 0755 /tmp/duckdb/duckdb /usr/local/bin/duckdb; \
    rm -rf /tmp/duckdb /tmp/duckdb.zip; \
    duckdb --version

# LAID OUT THE WAY `install.sh` LAYS IT OUT: the binary onto PATH, everything else under
# KONTRA_HOME. That equivalence is the point — an operator debugging this container is looking at
# the same tree they would have on a laptop, so every path in every error message means the same
# thing in both.
ENV KONTRA_HOME=/var/lib/kontra
COPY --from=release /out/kontra /usr/local/bin/kontra
COPY --from=release /out/bundles /var/lib/kontra/bundles
RUN kontra --version

# THE WHOLE HOME IS THE VOLUME, not `data/`. `config.yaml` — the console account and the four
# service tokens `kontra init` generates — is a SIBLING of `data/`, and a volume one level deeper
# would rotate the password on every `--force-recreate`, which is to say on every upgrade. Docker
# seeds a fresh named volume from the image, so `bundles/` is copied in on first use.
ENV KONTRA_DATA_DIR=/var/lib/kontra/data
VOLUME ["/var/lib/kontra"]


# FIRST BOOT INITIALISES, EVERY BOOT AFTER IT STARTS — and the one-time console password goes to the
# container log, which is where `docker compose logs kontra` looks and the only place it can go in
# an install nobody is attached to.
COPY kontra/control/images/entrypoint.sh /usr/local/bin/kontra-entrypoint
COPY kontra/examples/python/hello /opt/kontra/seed/actors/hello
COPY kontra/examples/workflows/hello /opt/kontra/seed/workflows/hello
COPY kontra/sdk/python /opt/kontra/sdk/python
COPY kontra/runtime/python /opt/kontra/runtime/python
# `cli/serve.go:prebuiltHandler` looks for exactly this path under KONTRA_SDK_ROOT.
COPY --from=release /handlerbin/handler /opt/kontra/handler
RUN chmod +x /usr/local/bin/kontra-entrypoint \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker.io python3 python3-pip python3-venv \
 && pip3 install --break-system-packages --no-cache-dir temporalio redis boto3 pydantic \
 && rm -rf /var/lib/apt/lists/*
ENV PYTHONPATH=/opt/kontra/sdk/python:/opt/kontra/runtime/python
ENV KONTRA_SDK_ROOT=/opt/kontra

# ── THE CNB `pack` BINARY, PINNED AND CHECKSUMMED (ADR 0061) ────────────────────────────────────
#
# `kontra deploy` builds actor images with Cloud Native Buildpacks, which means the lifecycle, which
# means `pack`. It is a BINARY and not a Go module on purpose: importing pack pulls its whole
# dependency graph into a CLI that also ships as a single download, and this image is the one place
# that needs it. `cli/packbuild.go:packBinary` looks here first.
#
# THE CHECKSUM IS THE POINT OF PINNING, not the version string. A tag can be re-pointed; a build
# that silently used a different lifecycle than the one this was tested against would produce actor
# images whose layers do not match what the catalog records.
#
# BOTH CHECKSUMS, EACH NAMED FOR WHAT IT COVERS. `kontra-runtimes/builder.json` records two for this
# release — one for the tarball and one for the `pack` binary inside it — and they are both 64 hex
# characters, so nothing about either value says which is which. Verifying /tmp/pack.tgz against the
# BINARY's digest failed every build with `/tmp/pack.tgz: FAILED`, a message that reads like a
# corrupted download or a re-pointed release. Checking both, under names, makes a swap fail on the
# first line and say so.
ARG PACK_VERSION=0.40.9
ARG PACK_TARBALL_SHA256=dc0ee1e931cf8a106d7555a01a214864f9acb60b77adf15d69b74df4404758e9
ARG PACK_BINARY_SHA256=2f85c3ec624f73f2d3c4a680a2c48fe6755197844730cc4ea5ed05f950fe05a3
ADD https://github.com/buildpacks/pack/releases/download/v${PACK_VERSION}/pack-v${PACK_VERSION}-linux.tgz /tmp/pack.tgz
RUN printf '%s  /tmp/pack.tgz\n' "${PACK_TARBALL_SHA256}" | sha256sum -c - \
 && tar -xzf /tmp/pack.tgz -C /usr/local/bin pack \
 && printf '%s  /usr/local/bin/pack\n' "${PACK_BINARY_SHA256}" | sha256sum -c - \
 && rm /tmp/pack.tgz \
 && /usr/local/bin/pack --version

# EVERYTHING `kontra deploy` STAGES INTO AN ACTOR IMAGE, ASSERTED HERE. The build context is
# assembled from this tree (cli/packstage.go): the handler is the actor's workflow half, and the two
# Python trees have to BOTH be present because the SDK's pyproject maps
# `internals = "../../runtime/python/internals"` — a vendored SDK with no sibling installs a `kontra`
# that cannot import its own actor host, and that failure arrives at load() on a Machine.
RUN test -x /opt/kontra/handler \
 && test -d /opt/kontra/sdk/python/kontra \
 && test -d /opt/kontra/runtime/python/internals \
 && test -x /usr/local/bin/pack
CMD ["kontra", "version"]
ENTRYPOINT ["/usr/local/bin/kontra-entrypoint"]
