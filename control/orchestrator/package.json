{
  "name": "@kontra/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kontra visual workflow orchestrator — Temporal TS worker/client + claim-check codec, byte-compatible with the Python codec.",
  "type": "commonjs",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @kontra/core run build && tsc",
    "typecheck": "pnpm --filter @kontra/core run build && tsc --noEmit",
    "test": "pnpm --filter @kontra/core run build && vitest run",
    "start": "node dist/src/main.js",
    "serve": "node dist/src/server.js",
    "materializer": "node dist/src/materializer.js",
    "infra": "node dist/src/infra.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@duckdb/node-api": "1.5.4-r.1",
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^8.3.0",
    "@kontra/core": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@pulumi/command": "^1.2.1",
    "@pulumi/digitalocean": "^4.81.0",
    "@pulumi/docker": "^4.11.2",
    "@pulumi/pulumi": "^3.267.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/interceptors-opentelemetry": "1.24.0",
    "@temporalio/proto": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@temporalio/workflow-streams": "1.24.0",
    "ajv": "^8.20.0",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "js-yaml": "4.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@temporalio/nexus": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
