{
  "compilerOptions": {
    /* NO `paths` ENTRY FOR @kontra/core, deliberately. It resolves through node_modules like any
       other dependency, because a `paths` mapping is believed by tsc and by nothing else: the
       extraction first went green on `tsc --noEmit` and red on 54 vitest files, then red on five
       more that build a Temporal Workflow bundle. Build core (`pnpm --filter @kontra/core build`)
       and every tool agrees; the workspace root's scripts do that first for exactly this reason. */
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2021"],
    "types": ["node"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts", "_gen/**/*.ts", "contract/**/*.ts", "entry.contract.ts", "catalog.contract.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.testwf.ts"]
}
