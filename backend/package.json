{
  "name": "@kontra/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kontra visual workflow orchestrator \u2014 Temporal TS worker/client + claim-check codec, byte-compatible with the Python codec.",
  "type": "commonjs",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/src/main.js",
    "serve": "node dist/src/server.js",
    "materializer": "node dist/src/materializer.js",
    "infra": "node dist/src/infra.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@duckdb/node-api": "1.5.4-r.1",
    "@fastify/compress": "^9.1.0",
    "@fastify/static": "^8.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@pulumi/command": "^1.2.1",
    "@pulumi/digitalocean": "^4.78.1",
    "@pulumi/pulumi": "^3.256.0",
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/common": "^1.11.0",
    "@temporalio/interceptors-opentelemetry": "1.18.1",
    "@temporalio/proto": "1.18.1",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "ajv": "^8.17.0",
    "fastify": "^5.1.0",
    "ioredis": "^6.0.0",
    "nexus-rpc": "0.0.2",
    "pg": "^8.22.0",
    "@kontra/core": "workspace:*"
  },
  "devDependencies": {
    "@temporalio/nexus": "^1.11.0",
    "@temporalio/testing": "^1.11.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.3",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
