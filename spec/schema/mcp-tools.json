{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontra.sh/schema/mcp/tools/v1.json",
  "title": "Input schemas of the gate's own MCP tools, and the output schema of hire and reply (spec/relay.md §12.2)",
  "$defs": {
    "part": {
      "type": "object",
      "description": "An A2A 1.0 Part: exactly one of text, raw (base64), url, data; plus optional filename, mediaType, metadata.",
      "oneOf": [ { "required": ["text"] }, { "required": ["raw"] }, { "required": ["url"] }, { "required": ["data"] } ],
      "properties": {
        "text": { "type": "string" }, "raw": { "type": "string", "contentEncoding": "base64" },
        "url": { "type": "string", "format": "uri" }, "data": { "not": { "type": "null" } },
        "filename": { "type": "string" }, "mediaType": { "type": "string" }, "metadata": { "type": "object" }
      }
    },
    "message": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "required": ["parts"], "additionalProperties": false,
          "properties": { "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } } } }
      ]
    },
    "search": {
      "type": "object", "additionalProperties": false,
      "properties": { "query": { "type": "string", "maxLength": 256 }, "kind": { "enum": ["a2a", "mcp"] },
                      "price": { "type": "string", "maxLength": 32 }, "cursor": { "type": "string" } }
    },
    "describe": {
      "type": "object", "required": ["service"], "additionalProperties": false,
      "properties": { "service": { "type": "string", "pattern": "^([a-z0-9-]+/)?[a-z0-9-]+$" } }
    },
    "hire": {
      "type": "object", "required": ["service", "message"], "additionalProperties": false,
      "properties": { "service": { "type": "string", "pattern": "^([a-z0-9-]+/)?[a-z0-9-]+$" },
                      "message": { "$ref": "#/$defs/message" }, "contextId": { "type": "string", "maxLength": 256 } }
    },
    "reply": {
      "type": "object", "required": ["taskId", "message"], "additionalProperties": false,
      "properties": { "taskId": { "type": "string", "format": "uuid" }, "message": { "$ref": "#/$defs/message" } }
    },
    "hireResult": {
      "type": "object",
      "description": "A hire task as hire and reply answer it: taskId and state always; url, the task's page on the operator's site, whenever the task has one; quote while a person must approve it there; text, the agent's answer or question or what the gate says of the task; data and files from the agent's parts.",
      "required": ["taskId", "state"], "additionalProperties": false,
      "properties": {
        "taskId": { "type": "string", "format": "uuid" },
        "state": { "enum": ["TASK_STATE_SUBMITTED", "TASK_STATE_WORKING", "TASK_STATE_INPUT_REQUIRED", "TASK_STATE_AUTH_REQUIRED",
                            "TASK_STATE_COMPLETED", "TASK_STATE_FAILED", "TASK_STATE_CANCELED", "TASK_STATE_REJECTED"] },
        "url": { "type": "string", "pattern": "^https://" },
        "quote": {
          "type": "object", "required": ["approveUrl", "expiresAt"], "additionalProperties": false,
          "properties": { "approveUrl": { "type": "string", "pattern": "^https://" }, "expiresAt": { "type": "string", "format": "date-time" } }
        },
        "text": { "type": "string" },
        "data": { "type": "array", "minItems": 1 },
        "files": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["uri"], "additionalProperties": false,
                     "properties": { "uri": { "type": "string" }, "name": { "type": "string" }, "mediaType": { "type": "string" } } }
        }
      }
    }
  }
}
