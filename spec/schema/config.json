{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontra.sh/schema/config/v1.json",
  "title": "kontra.yaml, the gate's configuration (PRD §11, note 1 §6, spec/relay.md §17). Written as YAML; this schema describes the decoded document. Durations are Go durations with a d (24 h) unit and are positive; sizes are positive integers of bytes or carry a binary suffix. What the schema cannot say (plaintext only on localhost, ACME domains, backend URL schemes, allow: globs that can match) is checked when the gate loads the file (internal/config).",
  "type": "object",
  "additionalProperties": false,
  "required": ["public_url", "postgres"],
  "properties": {
    "listen": { "$ref": "#/$defs/hostPort", "default": ":8080", "description": "The public listener." },
    "public_url": {
      "type": "string",
      "pattern": "^https?://[^/?#@]+(/[^?#]*)?$",
      "description": "The URL callers use; the served card carries it. Plaintext (no tls) is refused unless its host is localhost or a loopback address."
    },
    "signing_key": { "type": "string", "description": "file:<path> or a KMS reference. Cards are not signed until M3." },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exactly one of acme, cert+key, terminated_by_proxy off localhost; at most one anywhere.",
      "properties": {
        "acme": {
          "type": "object",
          "additionalProperties": false,
          "description": "Built-in ACME (TLS-ALPN-01 on the TLS listener, D82) with a directory cache: one replica only (D70).",
          "properties": {
            "email": { "type": "string" },
            "domains": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Default: the host of public_url, which the list must include." },
            "cache_dir": { "type": "string", "minLength": 1, "description": "Default: <user cache dir>/kontra-gate/acme." }
          }
        },
        "cert": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "terminated_by_proxy": {
          "type": "boolean",
          "default": false,
          "description": "A front proxy terminates TLS: the gate listens in plaintext with an https public_url; HSTS is the proxy's, the tunnel channel binding is none, and a warning is logged (D69)."
        }
      },
      "dependentRequired": { "cert": ["key"], "key": ["cert"] },
      "not": {
        "anyOf": [
          { "required": ["acme", "cert"] },
          { "required": ["acme", "terminated_by_proxy"], "properties": { "terminated_by_proxy": { "const": true } } },
          { "required": ["cert", "terminated_by_proxy"], "properties": { "terminated_by_proxy": { "const": true } } }
        ]
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_ip": {
          "type": "object",
          "additionalProperties": false,
          "description": "Where a client's address comes from, for rps_per_ip and conns_per_ip (D69).",
          "properties": {
            "from": { "enum": ["remote", "proxy_protocol", "x_forwarded_for"], "default": "remote", "description": "proxy_protocol (v1/v2) and x_forwarded_for (rightmost untrusted hop) are honoured only from trusted peers." },
            "trusted": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "The proxies' CIDRs (or single addresses)." }
          },
          "if": { "properties": { "from": { "enum": ["proxy_protocol", "x_forwarded_for"] } }, "required": ["from"] },
          "then": { "required": ["trusted"], "properties": { "trusted": { "minItems": 1 } } },
          "else": { "not": { "required": ["trusted"] } }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": { "$ref": "#/$defs/byteSize", "default": "4MiB" },
        "inflight_per_key": { "type": "integer", "minimum": 1, "default": 32 },
        "rps_per_ip": { "type": "number", "exclusiveMinimum": 0, "default": 50 },
        "header_timeout": { "$ref": "#/$defs/duration", "default": "10s" },
        "idle": { "$ref": "#/$defs/duration", "default": "60s" },
        "conns_per_ip": { "type": "integer", "minimum": 1, "default": 256, "description": "Enforced by the listener (D73)." },
        "max_conns": { "type": "integer", "minimum": 1, "default": 10000, "description": "Enforced by the listener (D73)." },
        "dispatch_slots": { "type": "integer", "minimum": 1, "default": 10000 },
        "push_slots": { "type": "integer", "minimum": 1, "default": 2000 },
        "task_bytes": { "$ref": "#/$defs/byteSize", "default": "256MiB" }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/$defs/hostPort", "default": "localhost:7233" },
        "namespace": { "type": "string", "minLength": 1, "default": "kontra" }
      }
    },
    "postgres": { "type": "string", "pattern": "^postgres(ql)?://", "description": "The gate's tables live in schema kontra (D37). Session-mode connections only (no transaction pooling)." },
    "blobs": { "type": "string", "pattern": "^s3://[^/]+", "description": "Optional claim-check bucket; without it parts over 256 KiB are refused (spec §10.4). M3." },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_keys": { "type": "boolean", "default": false },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "audience"],
          "properties": { "issuer": { "$ref": "#/$defs/httpsURL" }, "audience": { "type": "string", "minLength": 1 } }
        },
        "mcp_oauth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer"],
          "properties": { "issuer": { "$ref": "#/$defs/httpsURL" } }
        },
        "anonymous": { "type": "object", "additionalProperties": false, "description": "Reserved; per service, anonymous is an allow: entry." }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "listen": { "$ref": "#/$defs/hostPort", "default": ":9090" } }
    },
    "tenancy": { "enum": ["single", "multi"], "default": "single" },
    "caller_metadata": { "type": "array", "items": { "type": "string", "pattern": "^kontra\\..+" }, "default": [] },
    "operator_metadata_prefixes": { "type": "array", "items": { "type": "string", "pattern": "^kontra\\..+" }, "default": [], "description": "Each prefix lies under kontra. and is longer than it (D113)." },
    "push": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "allow_private": { "type": "boolean", "default": false, "description": "Skip the SSRF address check for webhooks and permit http:// (D67). Tests only." } }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "allowed_origins": { "type": "array", "items": { "type": "string", "pattern": "^https?://[^/?#@]+$" }, "default": [] } }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "secret_env"],
          "description": "The remote Admission hook (spec §13.1). M5: refused at load until built.",
          "properties": {
            "url": { "type": "string", "pattern": "^https?://" },
            "secret_env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "timeout": { "$ref": "#/$defs/duration", "default": "5s" },
            "operations": { "type": "array", "items": { "enum": ["task", "session", "call"] }, "default": ["task"] }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_queue"],
          "description": "The remote Lifecycle hook (spec §13.3). M5: refused at load until built.",
          "properties": { "task_queue": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "drain_timeout": { "$ref": "#/$defs/duration", "default": "10m" },
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel_binding": { "enum": ["tls-exporter", "none"], "description": "Default: tls-exporter when the gate terminates TLS, else none." },
        "anonymous": { "type": "boolean", "default": false },
        "enroll_with_api_key": { "type": "boolean", "default": false }
      }
    },
    "services": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
      "additionalProperties": { "$ref": "#/$defs/service" },
      "description": "Team gates only; Cloud leaves it empty and writes services into Postgres."
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h|d))+$"
    },
    "byteSize": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^[0-9]+ ?(B|KiB|MiB|GiB|TiB)?$" }
      ]
    },
    "hostPort": { "type": "string", "pattern": "^(\\[[0-9A-Fa-f:.]+\\]|[^:\\[\\]]*):[0-9]{1,5}$" },
    "httpsURL": { "type": "string", "pattern": "^https://[^/?#@]+" },
    "urlBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://[^/?#@]+(/[^?#]*)?$", "description": "The base URL (D71): the card is fetched relative to its path; only its scheme://host:port is dialed. http:// needs allow_private (D67)." },
        "allow_private": { "type": "boolean", "default": false }
      }
    },
    "allowEntry": {
      "type": "string",
      "pattern": "^(anonymous|key:[A-Za-z0-9_*?]+|org:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?|oidc:sub:.+|node:k1_[a-z2-7]{26})$",
      "description": "key:<prefix glob> (prefixes are [A-Za-z0-9_]{4,32}: write key:kk_acme_*, D68), org:<tenant>, oidc:sub:<subject>, node:<key_id>, anonymous."
    },
    "sealed": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "object", "additionalProperties": false, "properties": { "required": { "type": "boolean", "default": true } } }
      ],
      "default": false,
      "description": "false (off), true (required) or {required: bool}; ext-sealed.md §1."
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "backend"],
      "properties": {
        "kind": { "enum": ["a2a", "mcp"] },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "tunnel": { "type": "object", "additionalProperties": false },
            "a2a": { "$ref": "#/$defs/urlBackend" },
            "mcp": { "$ref": "#/$defs/urlBackend" }
          }
        },
        "allow": { "type": "array", "items": { "$ref": "#/$defs/allowEntry" }, "default": [], "description": "Deny by default (spec §2.3)." },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": { "type": "array", "items": { "type": "string", "pattern": "^[^?\\[\\]\\\\]+$" } },
            "deny": { "type": "array", "items": { "type": "string", "pattern": "^[^?\\[\\]\\\\]+$" } }
          }
        },
        "tasks": { "enum": ["durable", "passthrough", "off"] },
        "sealed": { "$ref": "#/$defs/sealed" },
        "seller_keys": {
          "oneOf": [
            { "type": "object", "additionalProperties": true, "required": ["keys"], "properties": { "keys": { "type": "array", "minItems": 1, "items": { "type": "object" } } }, "not": { "required": ["url"] } },
            { "type": "object", "additionalProperties": false, "required": ["url"], "properties": { "url": { "$ref": "#/$defs/httpsURL" } } }
          ],
          "description": "An inline JWKS or {url}; seller card signatures are verified against it (spec §3). M3."
        },
        "session_idle_s": { "type": "integer", "minimum": 1, "maximum": 2147483647, "default": 3600 },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": { "$ref": "#/$defs/duration", "default": "1h" },
            "retries": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2 },
            "retention": { "$ref": "#/$defs/duration", "default": "7d" }
          }
        },
        "listed": { "type": "boolean", "default": false },
        "annotations": { "type": "object", "default": {}, "description": "Operator data the gate attaches without interpreting (spec §13.4)." }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "a2a" } }, "required": ["kind"] },
          "then": { "not": { "anyOf": [ { "required": ["tools"] }, { "required": ["tasks"] } ] }, "properties": { "backend": { "not": { "required": ["mcp"] } } } }
        },
        {
          "if": { "properties": { "kind": { "const": "mcp" } }, "required": ["kind"] },
          "then": { "properties": { "backend": { "not": { "required": ["a2a"] } } } }
        }
      ]
    }
  }
}
