{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontra.sh/schema/price/v1.json",
  "title": "Metered price, _meta[\"sh.kontra/price\"] on tools/list entries (per_call) and the initialize result (per_session)",
  "type": "object",
  "required": ["model", "amount", "currency"],
  "properties": {
    "model": { "enum": ["per_call", "per_session"] },
    "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "freePerMonth": { "type": "integer", "minimum": 0 },
    "capPerMonth": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$" },
    "idleTimeoutSeconds": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    { "if": { "properties": { "model": { "const": "per_call" } } }, "then": { "not": { "required": ["idleTimeoutSeconds"] } } },
    { "if": { "properties": { "model": { "const": "per_session" } } }, "then": { "required": ["idleTimeoutSeconds"], "not": { "anyOf": [ { "required": ["freePerMonth"] }, { "required": ["capPerMonth"] } ] } } }
  ],
  "unevaluatedProperties": false
}
