{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontra.sh/schema/hooks/v1.json",
  "title": "Remote hook payloads (spec/relay.md §13): Admission over HTTPS, Lifecycle as Temporal activities. JSON, camelCase keys, durations in integer seconds.",
  "$defs": {
    "service": {
      "type": "object",
      "required": [
        "tenantId",
        "tenant",
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "tenant": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "a2a",
            "mcp"
          ]
        }
      }
    },
    "principal": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "buyerId",
        "via"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "key",
            "oidc",
            "node",
            "anonymous"
          ]
        },
        "id": {
          "type": "string"
        },
        "buyerId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "via": {
          "enum": [
            "api_key",
            "oidc",
            "mcp",
            "node",
            "anonymous"
          ]
        }
      }
    },
    "admitRequest": {
      "type": "object",
      "required": [
        "operation",
        "service",
        "principal",
        "protocol"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "task",
            "session",
            "call"
          ]
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "protocol": {
          "enum": [
            "a2a",
            "mcp"
          ]
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "The extensions the request activated: an A2A caller's A2A-Extensions that the served card declares (AP2's https://github.com/google-agentic-commerce/ap2/v1 among them, relay.md §2.6), or, for a hire of the gate's own /mcp, the operator's required card_extensions entries the gate activated for the buyer (relay.md §12.2, D300). The gate keys on the URI only; it never reads an extension's data parts for the hook."
        },
        "contextId": {
          "type": "string"
        },
        "message": {
          "type": "object",
          "required": [
            "messageId",
            "parts"
          ],
          "additionalProperties": false,
          "properties": {
            "messageId": {
              "type": "string"
            },
            "metadata": {
              "type": "object"
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "size",
                  "sealed"
                ],
                "additionalProperties": false,
                "properties": {
                  "mediaType": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sealed": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "tool": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "task"
              }
            }
          },
          "then": {
            "required": [
              "taskId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "call"
              }
            }
          },
          "then": {
            "required": [
              "tool"
            ]
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "refusal": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "integer",
              "description": "The JSON-RPC code of the refusal (relay.md §13.1, D325): one of A2A's own codes is that A2A error; -32099 to -32050 is the operator's own range (Cloud's -32060 to -32063), which /mcp answers as that code and the A2A routes as PERMISSION_DENIED with {\"code\": <code>} in the error's details. Any other code is PERMISSION_DENIED with the message alone on the A2A routes and -32603 on /mcp. /mcp/{svc} answers every code as it is."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "metadata": {
          "type": "object"
        },
        "mcpMeta": {
          "type": "object",
          "propertyNames": {
            "pattern": "^sh\\.kontra/"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "deny"
              }
            }
          },
          "then": {
            "required": [
              "refusal"
            ]
          }
        }
      ]
    },
    "taskRef": {
      "type": "object",
      "required": [
        "taskId",
        "tenantId",
        "service",
        "kind",
        "protocol",
        "buyerId",
        "principal",
        "via",
        "contextId",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "a2a",
            "mcp"
          ]
        },
        "protocol": {
          "enum": [
            "a2a",
            "mcp"
          ]
        },
        "buyerId": {
          "type": "string",
          "format": "uuid"
        },
        "principal": {
          "type": "string"
        },
        "via": {
          "enum": [
            "api_key",
            "oidc",
            "mcp",
            "node",
            "anonymous"
          ]
        },
        "contextId": {
          "type": "string"
        },
        "state": {
          "enum": [
            "submitted",
            "working",
            "input-required",
            "auth-required",
            "completed",
            "failed",
            "canceled",
            "rejected"
          ]
        },
        "metadata": {
          "type": "object",
          "description": "Only the operator-written keys (operator_metadata_prefixes), at most 16 KiB; never caller or service metadata"
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object"
        },
        "mcpMeta": {
          "type": "object",
          "propertyNames": {
            "pattern": "^sh\\.kontra/"
          }
        }
      }
    },
    "annotate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Payload of the kontra.annotate Update and signal (relay.md §13.3)",
      "properties": {
        "metadata": {
          "type": "object"
        },
        "mcpMeta": {
          "type": "object",
          "propertyNames": {
            "pattern": "^sh\\.kontra/"
          }
        }
      }
    },
    "dispatchedArgs": {
      "type": "object",
      "required": [
        "attempt"
      ],
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
