{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontra.sh/schema/ext/escrow/v1/params.json",
  "title": "Escrow extension params (https://kontra.sh/ext/escrow/v1)",
  "type": "object",
  "required": ["quote", "reviewWindowSeconds", "taskTimeoutSeconds", "rails", "terms"],
  "additionalProperties": false,
  "properties": {
    "quote": { "$ref": "#/$defs/money" },
    "reviewWindowSeconds": { "type": "integer", "minimum": 0, "maximum": 604800 },
    "taskTimeoutSeconds": { "type": "integer", "minimum": 1 },
    "rails": { "type": "array", "items": { "$ref": "#/$defs/rail" }, "minItems": 1, "uniqueItems": true },
    "terms": { "type": "string", "format": "uri", "pattern": "^https://" }
  },
  "$defs": {
    "rail": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "description": "A rail's name (ext-escrow.md §1, §3; D320): stripe (a card payment through Stripe), ledger (a hold kept in the operator's own ledger, with no payment-network object: a development or test gate's play balance), or an operator's own rail."
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "additionalProperties": false,
      "properties": {
        "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$", "not": { "pattern": "^0(\\.0+)?$" } },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  }
}
